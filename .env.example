# Copy this file to .env and fill in local values.
# Never put real tokens, passwords, or Gmail secrets in this file.
# Never paste TELEGRAM_BOT_TOKEN into Cursor or ChatGPT.

# Path to the private candidate profile (gitignored).
CAREER_AGENT_PROFILE_PATH=data/candidate_profile.json

# Logging: DEBUG, INFO, WARNING, ERROR
CAREER_AGENT_LOG_LEVEL=INFO

# Directory for local databases and generated files.
CAREER_AGENT_DATA_DIR=data

# Autonomy level: 1 = assistant (confirm every external action).
CAREER_AGENT_AUTONOMY_LEVEL=1

# Telegram BotFather token. Keep this only in local .env.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ID of the owner. Until this is set, only /whoami works.
TELEGRAM_ALLOWED_USER_ID=

# Gmail OAuth will be added in a later stage. Do not put a mailbox password here.
# CAREER_AGENT_GMAIL_CLIENT_SECRET_PATH=
